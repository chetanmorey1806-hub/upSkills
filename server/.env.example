# Copy to .env and fill in.
PORT=5050

# MySQL (the database is created automatically if the user is allowed to; tables are created on start)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=upskillr

# Long random string; changing it signs everybody out
JWT_SECRET=change-me-to-a-long-random-string

# The admin account created on first start (change the password after the first login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_NAME=Admin

# Where the website runs (comma separated). Needed so the browser may call this API.
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# Uploaded files are stored here (outside the website folder)
UPLOAD_DIR=./uploads
# Size limits in MB
ADMIN_MAX_MB=2048
CHAT_MAX_MB=50
